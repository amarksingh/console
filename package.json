{
  "name": "@ostro/console",
  "version": "1.0.7",
  "description": "Command module for OstroJS",
  "main": "build/application.js",
  "types": "build/application.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/application.d.ts",
      "default": "./build/application.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/contracts": "^1.0.4",
    "@ostro/support": "^1.2.1",
    "commander": "^8.3.0",
    "lodash": "^4.17.21",
    "string-argv": "^0.3.2"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "console",
    "command",
    "cli"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/console.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/console/issues"
  },
  "homepage": "https://github.com/ostrojs/console#readme"
}
